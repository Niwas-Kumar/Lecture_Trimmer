# Copy to .env and fill in. You need ONE of these two for the classification step:
ANTHROPIC_API_KEY=sk-ant-...     # Claude - best accuracy, paid
GOOGLE_API_KEY=AIza...           # Gemini - free tier is enough for testing
# CLASSIFIER_BACKEND=auto        # auto | claude | gemini
# GEMINI_MODEL=gemini-3.5-flash  # semantic analysis; configure adequate quota for shared use
# No automatic downgrade to a lighter model when quota is exhausted.

# Required: speech recognition (Groq Whisper large-v3-turbo)
GROQ_API_KEY=gsk_...

# Optional password for your local-only app. Public sharing uses Google sign-in below.
# TRIMMER_USER=teacher
# TRIMMER_PASSWORD=replace-with-a-long-private-password
# Optional encoder: auto (default), h264_nvenc, h264_qsv, or libx264.
# Auto probes actual hardware support and falls back to CPU when unavailable.
TRIMMER_ENCODER=auto
# Parallel rendering is bounded to avoid overloading the encoder; use 1 on a smaller host.
TRIMMER_RENDER_WORKERS=2

# Private multi-user hosting: read docs/AUTH_SETUP.md before enabling this mode.
# Keep Google credentials and provider API keys on the server, never in a client EXE.
# Remote access requires a stable HTTPS host with Google sign-in.
TRIMMER_AUTH=local
# Desktop Google login + PW Whitelisted / Lecture_Trimmer column:
# TRIMMER_AUTH=pw-desktop
# TRIMMER_DESKTOP_OAUTH_FILE=client_secret_YOUR_DESKTOP_CLIENT.json
# Classification uses Gemini 3.5 Flash through the signed-in PW account.
# Speech recognition still needs GROQ_API_KEY.
# Read docs/PW_DESKTOP_SETUP.md. No service-account JSON belongs in the desktop app.
# TRIMMER_AUTH=google-sheet
# TRIMMER_BASE_URL=https://lectures.example.com
# TRIMMER_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
# TRIMMER_GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
# TRIMMER_ACCESS_SHEET_ID=ID_FROM_THE_SHEET_URL
# TRIMMER_ACCESS_SHEET_RANGE=Access!A1:C10000
# TRIMMER_ACCESS_EMAIL_COLUMN=email
# TRIMMER_ACCESS_ENABLED_COLUMN=enabled
# TRIMMER_ACCESS_EXPIRES_COLUMN=expires_at
# TRIMMER_ACCESS_REFRESH_SECONDS=60
# TRIMMER_SESSION_SECONDS=28800
# Optional when the host does not supply Application Default Credentials:
# TRIMMER_GOOGLE_CREDENTIALS_FILE=C:/server-secrets/trimmer-service-account.json
# TRIMMER_TRUSTED_PROXY_IPS=127.0.0.1
