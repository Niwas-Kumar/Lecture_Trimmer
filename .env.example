# Copy to .env and fill in. You need ONE of these two for the classification step:
ANTHROPIC_API_KEY=sk-ant-...     # Claude - best accuracy, paid
GOOGLE_API_KEY=AIza...           # Gemini - free tier is enough for testing
# CLASSIFIER_BACKEND=auto        # auto | claude | gemini

# Optional: only needed for `--asr groq` (cloud transcription, much faster than CPU)
GROQ_API_KEY=gsk_...

# Optional: only needed for `--asr sarvam` (best for Hindi / Hinglish / Indian languages)
SARVAM_API_KEY=...
